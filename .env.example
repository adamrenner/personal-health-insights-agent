# Google API Key for accessing Google services.
GOOGLE_API_key="your_google_api_key_here"

# Tavily API Key for accessing Tavily search API.
TAVILY_API_KEY="your_tavily_api_key_here"
# API Configuration: 'gemini' or 'openai'
API_CHOICE='gemini'

# Gemini Configuration
GOOGLE_API_KEY="your-google-api-key"
GEMINI_MODEL_NAME="models/gemini-1.5-pro-latest"

# OpenAI Configuration
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL_NAME="gpt-4-turbo"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Tavily Search API Key (if used by the agent)
TAVILY_API_KEY="your-tavily-api-key"