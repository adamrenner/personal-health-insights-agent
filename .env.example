# Google API Key for accessing Google services.
GOOGLE_API_KEY="your-google-api-key"

# Tavily API Key for accessing Tavily search API.
TAVILY_API_KEY="your-tavily-api-key"

# API Configuration: 'gemini' or 'openai' or 'xai'
API_CHOICE='gemini'

# Gemini Configuration
GEMINI_MODEL_NAME="models/gemini-1.5-pro-latest"

# OpenAI Configuration
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL_NAME="gpt-4o"
OPENAI_BASE_URL="https://api.openai.com/v1"

# xAI/Grok Configuration
XAI_API_KEY="your-xai-api-key"
XAI_MODEL_NAME="grok-4-fast"
XAI_BASE_URL="https://api.x.ai/v1"